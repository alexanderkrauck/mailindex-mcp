# Copy to .env and edit. Fill in only the block for the compose file you use.
# Generate every secret with:  openssl rand -base64 32

# ---------------------------------------------------------------------------
# docker-compose.yml — local trial, loopback only, no authentication
# ---------------------------------------------------------------------------
EMAILSERVER_AUTH_MODE=development


# ---------------------------------------------------------------------------
# docker-compose.single-user.yml — one owner, static bearer token, HTTPS
# ---------------------------------------------------------------------------
# EMAILSERVER_DOMAIN=mail.example.com
# POSTGRES_PASSWORD=replace-me
# EMAILSERVER_API_TOKEN=replace-me          # at least 32 characters
# CREDENTIAL_ENCRYPTION_KEY=replace-me
# SESSION_SECRET=replace-me
#
# Optional, and only to connect Gmail mailboxes by OAuth instead of an app
# password. Unrelated to how you sign in to this server.
# GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me


# ---------------------------------------------------------------------------
# docker-compose.production.yml — multiple users, Google OAuth, HTTPS
# ---------------------------------------------------------------------------
# EMAILSERVER_DOMAIN=mail.example.com
# POSTGRES_PASSWORD=replace-me
# GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-me
# JWT_SIGNING_KEY=replace-me
# CREDENTIAL_ENCRYPTION_KEY=replace-me
# SESSION_SECRET=replace-me
# REGISTRATION_MODE=allowlist
# ALLOWED_GOOGLE_EMAILS=["owner@example.com"]
# ALLOWED_GOOGLE_SUBJECTS=[]
# CLAIM_LEGACY_ACCOUNTS_ON_FIRST_LOGIN=false


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Which image to run. Defaults to :latest, which will apply new migrations to
# your database the moment you restart. Pin it for anything you care about.
# MAILINDEX_IMAGE=ghcr.io/alexanderkrauck/mailindex-mcp:0.1.0
#
# OCR languages for image attachments. Empty uses every language installed in
# the image (eng deu fra ita spa nld por by default), which is what mixed
# language mailboxes need. Pin a subset to make extraction faster.
# EMAILSERVER_OCR_LANGUAGES=deu+eng
#
# Languages full-text search stems against. "simple" is always included and is
# what match="exact" searches. Every other entry adds a stemmed copy of the same
# text to one combined index, so "invoice" finds "invoices" and "Rechnung" finds
# "Rechnungen". Changing this after the first start needs a matching index built
# by hand; the README has the statement.
# EMAILSERVER_SEARCH_TEXT_CONFIGS=["simple","english","german"]
#
# Days a message stays tombstoned before it is physically removed. It leaves
# search immediately; the delay only exists so a wrong deletion inference is
# recoverable.
# EMAILSERVER_TOMBSTONE_GRACE_DAYS=7
#
# Sync isolation and liveness (seconds). These values are forwarded by every
# shipped compose file. Every account runs in a fresh supervised process;
# cleanup is a short additional allowance after the absolute job deadline.
# EMAILSERVER_SYNC_ACCOUNT_CONCURRENCY=2
# EMAILSERVER_SYNC_JOB_TIMEOUT_SECONDS=300
# EMAILSERVER_SYNC_JOB_CLEANUP_SECONDS=5
# EMAILSERVER_SYNC_WATCHDOG_TIMEOUT_SECONDS=30
# EMAILSERVER_SYNC_STALE_AFTER_SECONDS=900
# EMAILSERVER_IMAP_COMMAND_TIMEOUT_SECONDS=60
# EMAILSERVER_IMAP_CLEANUP_TIMEOUT_SECONDS=5
